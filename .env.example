# Copy to apps/web/.env.local and packages/db/.env (or export in your shell).

# Postgres.
#   Local (default): embedded Postgres in .data/pg — no Docker needed.
#   Docker:          `pnpm db:up`, then postgres://careerforge:careerforge@localhost:5432/careerforge
#   Production:      the Neon pooled connection string.
DATABASE_URL=pglite:.data/pg

# Auth provider: "clerk" or "dev". Defaults to "clerk" when a publishable key is present.
# "dev" is a signed-cookie login for local work; it refuses to run in production unless
# ALLOW_DEV_AUTH=1 is set explicitly.
NEXT_PUBLIC_AUTH_PROVIDER=dev
AUTH_SECRET=change-me-to-32-plus-random-characters
# Session cookies are Secure (https-only) in production. Set 0 when the site is served over
# plain http, e.g. a fresh Elastic Beanstalk URL; otherwise sign-in does not stick.
# AUTH_COOKIE_SECURE=0

# Clerk (production). Create an application at https://dashboard.clerk.com.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Code judge. Production: a Judge0 CE instance (isolated, no network — ADR-010).
#   JUDGE0_URL=https://judge.example.com
# Local development / demo ONLY: runs g++, javac, python and node on this machine.
# Not a sandbox — refused when NODE_ENV=production.
JUDGE_PROVIDER=local

# AI code review (no runner needed): an OpenRouter model reads the code against the tests.
# Used when neither JUDGE0_URL nor JUDGE_PROVIDER=local is set. Free models work; verdicts are
# labelled "AI-reviewed" and count half as much evidence, since nothing is executed.
#   OPENROUTER_API_KEY=sk-or-...
#   OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free   (optional; falls back to openrouter/free)

# AI layer. Without a key the deterministic rubric judge is used (AI_MODE=fixtures).
# With ANTHROPIC_API_KEY set, mock interviews and explanations are judged by Claude
# (qualitative levels only — numbers are always computed by code, ADR-006).
AI_MODE=fixtures
ANTHROPIC_API_KEY=

# Gateway (apps/gateway) — optional.
REDIS_URL=redis://localhost:6379
GATEWAY_URL=
